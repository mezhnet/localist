{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Localist",
  "version": "1.0.0",
  "identifier": "de.localist.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Localist",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Localist",
    "copyright": "© 2026 Localist",
    "category": "Productivity",
    "shortDescription": "Notizen und Projekte als Markdown-Dateien",
    "longDescription": "Localist ist ein Notiz- und Projektmanager im Stil von Notion. Alle Seiten liegen als normale Markdown-Dateien in einem Ordner auf deinem Rechner – ohne Konto, ohne Server, komplett offline.",
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ]
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
