{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Localist",
  "version": "2.3.2",
  "identifier": "de.localist.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Localist",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "localist-seite: http://localist-seite.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420",
        "frame-src": "localist-seite: http://localist-seite.localhost http://localhost:1420",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Localist",
    "copyright": "© 2026 Localist",
    "category": "Productivity",
    "shortDescription": "Notizen und Projekte als Markdown-Dateien",
    "longDescription": "Localist ist ein Notiz- und Projektmanager im Stil von Notion. Alle Seiten liegen als normale Markdown-Dateien in einem Ordner auf deinem Rechner – ohne Konto, ohne Server, komplett offline.",
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ]
      },
      "wix": {
        "language": "de-DE"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRUUzMUY2N0EzQzc4OUUKUldTZWVEeDY5akh1YThIcW1zdEZQOW84NzYzR0tCYzJWQW82Wjh6b1JMRXhJM0tzM0k3SzVoVHIK",
      "endpoints": [
        "https://github.com/mezhnet/localist/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
